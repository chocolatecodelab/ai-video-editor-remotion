[
  {
    "start": 0,
    "end": 1.3,
    "en": "As you grow,",
    "id": "Seiring kamu bertumbuh,"
  },
  {
    "start": 1.4,
    "end": 3.4,
    "en": "you realize that not everyone",
    "id": "kamu sadar, tidak semua orang"
  },
  {
    "start": 3.4,
    "end": 5.99,
    "en": "is meant to stay in your life forever.",
    "id": "akan selamanya hadir dalam hidupmu."
  },
  {
    "start": 6.78,
    "end": 9.5,
    "en": "Some people are only part of a certain chapter,",
    "id": "Sebagian orang hanya hadir dalam satu bab,"
  },
  {
    "start": 9.84,
    "end": 11.8,
    "en": "not the entire story.",
    "id": "bukan sepanjang ceritamu."
  },
  {
    "start": 12.48,
    "end": 13.94,
    "en": "And that’s okay.",
    "id": "Dan itu wajar."
  },
  {
    "start": 13.94,
    "end": 16.7,
    "en": "You might have different dreams,",
    "id": "Mungkin impian kalian berbeda,"
  },
  {
    "start": 17.1,
    "end": 18.8,
    "en": "different priorities,",
    "id": "prioritas kalian berbeda,"
  },
  {
    "start": 19.08,
    "end": 21.2,
    "en": "and different directions.",
    "id": "begitu pula arah yang kalian tuju."
  },
  {
    "start": 22.08,
    "end": 25.7,
    "en": "Don’t feel guilty for choosing growth,",
    "id": "Jangan merasa bersalah memilih untuk bertumbuh,"
  },
  {
    "start": 26.08,
    "end": 28.1,
    "en": "even when it means walking away",
    "id": "meski itu berarti meninggalkan"
  },
  {
    "start": 28.1,
    "end": 31.05,
    "en": "from things that once felt familiar.",
    "id": "hal-hal yang dulu terasa akrab."
  },
  {
    "start": 31.88,
    "end": 35.08,
    "en": "You don’t have to hate your past to move forward.",
    "id": "Kamu tak harus membenci masa lalumu untuk melangkah maju."
  },
  {
    "start": 35.08,
    "end": 37.65,
    "en": "Sometimes growing means",
    "id": "Terkadang, bertumbuh berarti"
  },
  {
    "start": 37.65,
    "end": 40.62,
    "en": "accepting that you no longer belong",
    "id": "menerima bahwa kamu tak lagi cocok"
  },
  {
    "start": 40.62,
    "end": 43.1,
    "en": "where you used to be.",
    "id": "di tempatmu yang dulu."
  }
]