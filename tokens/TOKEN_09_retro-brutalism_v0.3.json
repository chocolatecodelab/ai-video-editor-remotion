{
  "_meta": {
    "id": "retro-brutalism",
    "versi": "0.3",
    "status": "draft",
    "catatan": "Gaya Retro Brutalism. Font dari folder font Windows/pengguna; ganti di sini bila memakai font lain. Font: Anton + Courier New (Google Fonts di pipeline/fonts/ bila tidak terpasang)."
  },
  "warna": {
    "latar": "#F2EBDD",
    "teks-utama": "#000000",
    "teks-sekunder": "#1A1A1A",
    "aksen": "#B83900",
    "aksen-2": "#2D5BFF",
    "peringatan": "#FF0033",
    "panel": "#FFFFFF",
    "panel-opasitas": 1.0,
    "garis-panel": "#000000",
