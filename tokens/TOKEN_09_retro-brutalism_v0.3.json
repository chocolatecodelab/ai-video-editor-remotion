      0.9,
      0.0,
      0.1,
      1.0
    ],
    "tegas": [
      1.0,
      0.0,
      0.0,
      1.0
    ],
    "keluar": [
      1.0,
      0.0,
      1.0,
      1.0
    ]
  },
  "gerak": {
